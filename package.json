    "eslint-plugin-react-refresh": "^0.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ts-jest" : "^29.4.14",
    "typescript" : "^7.0.2",
    "typescript-eslint" : "^8.71.1"
  },
